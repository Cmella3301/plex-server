# Never upload actual media files
D:\PlexMedia\

# Plex config database and logs (large files, sensitive data)
config/Library/Application Support/Plex Media Server/Plug-in Support/
config/Library/Application Support/Plex Media Server/Media/
config/Library/Application Support/Plex Media Server/Metadata/
config/Library/Application Support/Plex Media Server/Logs/
config/Library/Application Support/Plex Media Server/Cache/

# Sensitive config files with passwords/tokens
deluge-config/core.conf
deluge-config/web.conf
config/Library/Application Support/Plex Media Server/Preferences.xml

# Radarr/Sonarr databases
radarr-config/*.db
sonarr-config/*.db

# General
*.log
*.tmp
Thumbs.db
.DS_Store
